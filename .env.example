# Supabase 풀러의 transaction mode 포트 6543 을 사용합니다. session mode(5432)는 동시
# 클라이언트가 15개로 제한되어 API 1개 + worker 4개만으로도 한도를 넘습니다.
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_EMOTION_MODEL=
OPENAI_FEEDBACK_MODEL=
OPENAI_INTERVIEW_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=3072

QUEUE_NAMES=["conversation_text","conversation_text_dlq","interactive_ai","interactive_ai_dlq","evaluation_ai","evaluation_ai_dlq","document_analysis","document_analysis_dlq"]
# 로컬 시연에서는 구현된 base worker 네 개의 heartbeat를 모두 검사합니다.
REQUIRED_WORKER_QUEUES=["conversation_text","interactive_ai","evaluation_ai","document_analysis"]
JWT_LEEWAY_SECONDS=5
# Local development starting values only. Re-measure before production use.
PAGINATION_LIMIT=20
USER_QUEUE_LIMIT=4
WORKER_CONCURRENCY=2
WORKER_VISIBILITY_TIMEOUT_SECONDS=240
RAG_SIMILARITY_THRESHOLD=0.35
CONTEXT_SUMMARY_TRIGGER_TOKENS=4000
DOCUMENT_MIN_TEXT_CHARS=100
WORKER_HEARTBEAT_TTL_SECONDS=30
IDEMPOTENCY_LEASE_SECONDS=30
IDEMPOTENCY_RETENTION_SECONDS=86400
